{
  "name": "opencode-plugin-ssh",
  "version": "0.2.0",
  "description": "Persistent interactive SSH sessions, profiles, remote SFTP/SCP transfers, and background jobs for Claude Code, OpenCode, and MCP clients",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "opencode-plugin-ssh": "./bin/mcp.js",
    "opencode-ssh-mcp": "./bin/mcp.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp.js",
      "types": "./dist/mcp.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    }
  },
  "files": [
    "dist",
    "bin",
    ".claude-plugin",
    ".mcp.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration",
    "prepack": "npm run build",
    "dev": "tsup src/index.ts --format esm --watch",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maik205/opencode-ssh.git"
  },
  "bugs": {
    "url": "https://github.com/maik205/opencode-ssh/issues"
  },
  "homepage": "https://github.com/maik205/opencode-ssh#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "mcp",
    "mcp-server",
    "claude",
    "claude-code",
    "claude-plugin",
    "model-context-protocol",
    "ssh",
    "ssh2",
    "sftp",
    "scp",
    "pty",
    "terminal",
    "remote-development",
    "agentic-workflow"
  ],
  "author": "maik205",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ssh-config": "^5.3.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.12",
    "@types/node": "^26.6.2",
    "@types/ssh2": "^1.15.6",
    "solid-js": "^1.9.15",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  }
}
