{
  "name": "opencode-plugin-ssh",
  "version": "0.1.2",
  "description": "Persistent interactive SSH sessions, profiles, remote SFTP editing, and background job supervision for OpenCode v2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration",
    "dev": "tsup src/index.ts --format esm --watch",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maik205/opencode-ssh.git"
  },
  "bugs": {
    "url": "https://github.com/maik205/opencode-ssh/issues"
  },
  "homepage": "https://github.com/maik205/opencode-ssh#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ssh",
    "ssh2",
    "sftp",
    "pty",
    "terminal",
    "remote-development",
    "agentic-workflow"
  ],
  "author": "maik205",
  "license": "MIT",
  "dependencies": {
    "ssh-config": "^5.3.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.12",
    "@types/node": "^26.6.2",
    "@types/ssh2": "^1.15.6",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0"
  }
}
